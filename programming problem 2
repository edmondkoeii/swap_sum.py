def swap_sum(A, B):
    numerator = sum(A) - sum(B) + 10
    if numerator % 2 != 0:
        return None
    target = numerator // 2  # need A[i] - B[j] == target

    i, j = 0, 0
    while i < len(A) and j < len(B):
        diff = A[i] - B[j]
        if diff == target:
            return (i, j)
        elif diff < target:
            i += 1   
        else:
            j += 1   

    return None
